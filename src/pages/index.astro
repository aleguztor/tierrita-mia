---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import waIcon from '../assets/waIcon.png'
import hero from '../assets/pulpogallega.jpg'
import zamburinas from '../assets/zamburinas.jpg'
import sardinas from '../assets/sardinas.jpg'
import boquerones from '../assets/boquerones.jpeg'
import { SITE } from '../data/site'

const platos = [
  { img: sardinas, name: 'Espetos de sardinas', desc: 'Al fuego de leña, como en la playa.' },
  { img: zamburinas, name: 'Zamburiñas a la plancha', desc: 'Frescas, con ajo y perejil.' },
  { img: hero, name: 'Pulpo a la brasa', desc: 'Con alioli de pimentón.' },
  { img: boquerones, name: 'Boquerones fritos', desc: 'Crujientes, el clásico malagueño.' },
]
---

<Layout>
  <section class="hero">
    <Image src={hero} alt="" class="hero-img" loading="eager" widths={[800, 1400, 2000]} sizes="100vw" />
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <p class="eyebrow">Torre del Mar · Málaga</p>
      <h1>Tierrita Mía</h1>
      <p class="lead">Pescado fresco, cariño en cada plato y el auténtico sabor de nuestra tierra, frente al mar.</p>
      <div class="actions">
        <a class="btn btn-primary" href={SITE.whatsappReserva} target="_blank" rel="noopener">
          <Image width={24} height={24} src={waIcon} alt="" /> Reservar mesa
        </a>
        <a class="btn btn-ghost" href="/carta">Ver la carta</a>
      </div>
    </div>
  </section>

  <section class="section container" id="especialidades">
    <p class="eyebrow">De la lonja a tu mesa</p>
    <h2>Nuestras especialidades</h2>
    <div class="grid">
      {
        platos.map((p) => (
          <article class="card">
            <Image
              src={p.img}
              alt={p.name}
              width={480}
              height={360}
              widths={[360, 480, 720]}
              sizes="(max-width: 640px) 100vw, 25vw"
            />
            <div>
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
    <div class="center">
      <a class="btn btn-ghost" href="/carta">Descubre toda la carta</a>
    </div>
  </section>

  <section class="quote">
    <div class="container">
      <blockquote>
        “Cada bocado es un viaje a las recetas de la abuela, donde el sabor del mar se encuentra con la tradición.”
      </blockquote>
    </div>
  </section>

  <section class="section container where" id="localizacion">
    <div class="where-text">
      <p class="eyebrow">Dónde estamos</p>
      <h2>Junto al mar</h2>
      <p>Nos encontramos en Torre del Mar, muy cerca de la costa. Disfruta de nuestras vistas a la playa.</p>
      <div class="actions">
        <a class="btn btn-primary" href={SITE.phoneHref}>Llamar al {SITE.phone}</a>
        <a class="btn btn-ghost" href={SITE.mapsHref} target="_blank" rel="noopener">Cómo llegar</a>
      </div>
    </div>
    <iframe
      title="Mapa de Torre del Mar"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6394.664142163913!2d-4.093244600000001!3d36.7385996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd7247be9d0d3fcf%3A0x5bb97f649ada83a4!2s29740%20Torre%20del%20Mar%2C%20M%C3%A1laga!5e0!3m2!1ses!2ses!4v1743685991885!5m2!1ses!2ses"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 720px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(16, 44, 55, 0.92) 0%, rgba(26, 68, 83, 0.7) 55%, rgba(26, 68, 83, 0.35) 100%),
      linear-gradient(0deg, var(--primary-dark) 0%, transparent 30%);
  }
  .hero-content {
    position: relative;
    padding-top: 60px;
    padding-bottom: 80px;
  }
  .hero h1 {
    font-size: clamp(3.2rem, 11vw, 7rem);
    margin: 12px 0 18px;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }
  .lead {
    max-width: 520px;
    font-size: 1.15rem;
    margin-bottom: 30px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .actions img {
    width: 24px;
    height: 24px;
  }
  .section {
    padding-top: 80px;
    padding-bottom: 20px;
  }
  .section h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 6px 0 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
  }
  .card {
    background: var(--primary);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 250ms;
  }
  .card:hover {
    transform: translateY(-6px);
  }
  .card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .card div {
    padding: 16px 18px 20px;
  }
  .card h3 {
    font-size: 1.2rem;
    margin-bottom: 6px;
  }
  .card p {
    font-size: 0.92rem;
    color: var(--secondary);
    color: rgb(190, 206, 212);
  }
  .center {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }
  .quote {
    margin-top: 80px;
    padding: 70px 0;
    background: var(--primary);
    text-align: center;
  }
  blockquote {
    max-width: 760px;
    margin: 0 auto;
    font-family: var(--font-title);
    font-weight: 300;
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    line-height: 1.35;
  }
  .where {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 40px;
    align-items: center;
  }
  .where-text p:not(.eyebrow) {
    margin-bottom: 26px;
    max-width: 420px;
  }
  .where iframe {
    width: 100%;
    height: 360px;
    border: 0;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  @media (max-width: 820px) {
    .where {
      grid-template-columns: 1fr;
    }
    .hero-shade {
      background: linear-gradient(0deg, var(--primary-dark) 0%, rgba(26, 68, 83, 0.8) 100%);
    }
  }
</style>
