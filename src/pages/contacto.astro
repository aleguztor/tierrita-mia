---
import Layout from '../layouts/Layout.astro'
import { SITE } from '../data/site'
---

<Layout
  title="Contacto"
  description="Reserva mesa o escríbenos: Tierrita Mía, Torre del Mar. Llama al 626 59 11 57 o por WhatsApp."
>
  <header class="head">
    <p class="eyebrow">Hablemos</p>
    <h1>Contacto</h1>
    <p class="sub">Reserva tu mesa o cuéntanos lo que necesites. Te respondemos lo antes posible.</p>
  </header>

  <div class="container layout">
    <div class="ways">
      <a class="way" href={SITE.phoneHref}>
        <span class="label">Llámanos</span>
        <span class="value">{SITE.phone}</span>
      </a>
      <a class="way" href={SITE.whatsappReserva} target="_blank" rel="noopener">
        <span class="label">WhatsApp</span>
        <span class="value">Reservar por mensaje</span>
      </a>
      <a class="way" href={SITE.mapsHref} target="_blank" rel="noopener">
        <span class="label">Ven a vernos</span>
        <span class="value">Torre del Mar, Málaga</span>
      </a>
    </div>

    <form id="contact-form" novalidate>
      <h2>Escríbenos</h2>
      <div class="field">
        <label for="nombre">Nombre</label>
        <input type="text" id="nombre" name="nombre" autocomplete="name" required placeholder="Tu nombre" />
      </div>
      <div class="field">
        <label for="mensaje">Mensaje</label>
        <textarea
          id="mensaje"
          name="mensaje"
          rows="5"
          required
          placeholder="Día, hora y número de personas, o tu consulta"></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Enviar por WhatsApp</button>
      <p class="hint">Se abrirá WhatsApp con tu mensaje listo para enviar.</p>
    </form>
  </div>
</Layout>

<style>
  .head {
    text-align: center;
    padding: 56px 20px 36px;
  }
  .head h1 {
    font-size: clamp(2.8rem, 9vw, 5rem);
    margin: 6px 0 12px;
  }
  .sub {
    max-width: 480px;
    margin: 0 auto;
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 32px;
    align-items: start;
    padding-bottom: 40px;
  }
  .ways {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .way {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 22px 24px;
    background: var(--primary);
    border-radius: var(--radius);
    border: 1px solid rgba(255, 237, 209, 0.12);
    transition:
      transform 200ms,
      border-color 200ms;
  }
  .way:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .label {
    font-family: var(--font-title);
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--accent);
  }
  .value {
    font-family: var(--font-title);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
  }
  form {
    background: var(--link-light);
    color: var(--primary);
    padding: 32px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  form h2 {
    margin-bottom: 20px;
    font-size: 1.6rem;
  }
  .field {
    margin-bottom: 18px;
  }
  label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  input,
  textarea {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid rgba(26, 68, 83, 0.2);
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: 1rem;
    background: white;
    color: var(--primary);
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--primary);
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: #c0392b;
  }
  textarea {
    resize: vertical;
  }
  form .btn {
    width: 100%;
    background: var(--primary);
    color: var(--link);
    border-color: var(--primary);
  }
  form .btn:hover {
    background: var(--primary-dark);
  }
  .hint {
    margin-top: 12px;
    font-size: 0.82rem;
    text-align: center;
    color: var(--secondary);
  }
  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }
    form {
      padding: 24px 20px;
    }
  }
</style>

<script>
  import { SITE } from '../data/site'

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null
    if (!form) return
    form.addEventListener('submit', (e) => {
      e.preventDefault()
      const nombre = form.elements.namedItem('nombre') as HTMLInputElement
      const mensaje = form.elements.namedItem('mensaje') as HTMLTextAreaElement
      let valid = true
      for (const field of [nombre, mensaje]) {
        const empty = !field.value.trim()
        field.setAttribute('aria-invalid', String(empty))
        if (empty && valid) field.focus()
        valid &&= !empty
      }
      if (!valid) return
      const text = `Hola, soy ${nombre.value.trim()}. ${mensaje.value.trim()}`
      window.open(`${SITE.whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener')
    })
  })
</script>
