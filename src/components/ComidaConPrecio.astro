---
interface Props {
  title: string
  price: string
  unit?: string
}
const { title, price, unit = '€' } = Astro.props
---

<li class="item">
  <span class="name">{title}</span>
  <span class="dots" aria-hidden="true"></span>
  <span class="price">{price}{unit}</span>
</li>

<style>
  .item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    list-style: none;
    padding: 6px 0;
  }
  .name {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .dots {
    flex: 1;
    min-width: 12px;
    border-bottom: 2px dotted rgba(26, 68, 83, 0.3);
    transform: translateY(-4px);
  }
  .price {
    font-family: var(--font-title);
    font-weight: 500;
    font-size: 1.05rem;
    white-space: nowrap;
    color: var(--primary);
  }
</style>
