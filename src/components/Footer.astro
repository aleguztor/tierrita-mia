---
import { SITE } from '../data/site'
---

<footer>
  <div class="container grid">
    <div>
      <p class="name">Tierrita Mía</p>
      <p class="muted">{SITE.tagline}.</p>
    </div>
    <nav aria-label="Pie de página">
      <a href="/">Inicio</a>
      <a href="/carta">Carta</a>
      <a href="/contacto">Contacto</a>
    </nav>
    <div>
      <a href={SITE.phoneHref}>Tel. {SITE.phone}</a>
      <a href={SITE.whatsappReserva} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
  <p class="copy">© {new Date().getFullYear()} Tierrita Mía · Web creada por Alejandro Guzmán</p>
</footer>

<style>
  footer {
    background: var(--primary-dark);
    border-top: 1px solid rgba(255, 237, 209, 0.12);
    padding: 40px 0 24px;
    margin-top: 40px;
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 28px;
  }
  .grid > * {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .name {
    font-family: var(--font-title);
    font-size: 1.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .muted,
  .copy {
    color: var(--secondary);
    font-size: 0.9rem;
  }
  a:hover {
    color: var(--accent);
  }
  .copy {
    text-align: center;
    margin-top: 32px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .grid > * {
      align-items: center;
    }
  }
</style>
